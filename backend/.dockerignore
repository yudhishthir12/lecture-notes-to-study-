# Version control
.git
.gitignore

# Environment & secrets (never bake these into an image)
.env
.env.*
!.env.example

# Python caches & virtualenvs
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/

# Test suite (not needed at runtime)
tests/

# Runtime data volumes
uploads/
exports/
*.log

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
