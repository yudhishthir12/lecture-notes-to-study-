# LectureForge AI - Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://lectureforge:lectureforge@postgres:5432/lectureforge
DATABASE_URL_SYNC=postgresql://lectureforge:lectureforge@postgres:5432/lectureforge
POSTGRES_USER=lectureforge
POSTGRES_PASSWORD=lectureforge
POSTGRES_DB=lectureforge

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Application
BACKEND_URL=http://backend:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/app/uploads
EXPORT_DIR=/app/exports

# Pipeline
PROMPT_VERSION=v1.0
MAX_RETRY_ATTEMPTS=2
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# Security
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
SECRET_KEY=change-this-to-a-random-secret-key

# Observability
LOG_LEVEL=INFO
ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
