# =============================================================================
# LectureForge AI - Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
# NEVER commit the resulting `.env` file (it is already gitignored).
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# 'console' for local dev, 'json' for production log aggregation
LOG_FORMAT=console

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Used by the `postgres` service inside docker-compose and by the app.
# When running WITHOUT Docker, change the host to `localhost`.
DATABASE_URL=postgresql+asyncpg://lectureforge:lectureforge@postgres:5432/lectureforge
# Optional: if omitted, it is derived automatically from DATABASE_URL.
DATABASE_URL_SYNC=postgresql://lectureforge:lectureforge@postgres:5432/lectureforge
POSTGRES_USER=lectureforge
POSTGRES_PASSWORD=lectureforge
POSTGRES_DB=lectureforge

# -----------------------------------------------------------------------------
# Redis / Celery (background task queue)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_CONCURRENCY=2
# Run `alembic upgrade head` on container start (API only; workers set false).
RUN_MIGRATIONS=true

# -----------------------------------------------------------------------------
# Google Gemini API
# -----------------------------------------------------------------------------
# REQUIRED for study pack generation. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# Frontend / Service URLs
# -----------------------------------------------------------------------------
# URL the browser uses to reach the backend (must be publicly reachable).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Internal backend URL used by the Next.js server-side proxy.
BACKEND_URL=http://backend:8000
# Public URL of the deployed frontend (used for CORS / links).
FRONTEND_URL=http://localhost:3000
# Comma-separated list of extra image hostnames allowed by next/image.
NEXT_PUBLIC_IMAGE_DOMAINS=localhost

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/app/uploads
EXPORT_DIR=/app/exports

# -----------------------------------------------------------------------------
# Pipeline & Processing
# -----------------------------------------------------------------------------
PROMPT_VERSION=v1.0
MAX_RETRY_ATTEMPTS=2
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Comma-separated list of allowed browser origins (or a JSON array).
# In production set this to your real frontend URL, e.g. https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-secret-key

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
