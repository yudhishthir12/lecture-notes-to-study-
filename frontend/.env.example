# LectureForge AI - Frontend Environment Configuration (local, without Docker)
# API Base URL for backend communication (injected into client bundles and server requests)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Internal backend URL used by the Next.js server-side proxy (rewrites)
BACKEND_URL=http://localhost:8000
# Comma-separated hostnames allowed by next/image
NEXT_PUBLIC_IMAGE_DOMAINS=localhost
