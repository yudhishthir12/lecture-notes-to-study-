# =============================================================================
# LectureForge AI - Frontend Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
# NEVER commit the resulting `.env` file (it is already gitignored).
# =============================================================================

# Public URL of the deployed backend API. This is BAKED INTO THE CLIENT BUNDLE
# AT BUILD TIME, so set it before `npm run build` (and rebuild if it changes).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL used by the Next.js server-side proxy (next.config.js rewrites).
# Usually the same as NEXT_PUBLIC_API_URL; for same-origin deployments it can
# point at an internal address.
BACKEND_URL=http://localhost:8000

# Comma-separated hostnames allowed by next/image.
NEXT_PUBLIC_IMAGE_DOMAINS=localhost

# Emit the self-contained standalone server output (used by the Docker image).
NEXT_OUTPUT_STANDALONE=true
